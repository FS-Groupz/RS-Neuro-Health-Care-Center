# RS Neuro Health Care Center — Backend Environment Configuration Example
# Copy this file to .env for local deployment. Never commit .env to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Allowed Origins for CORS (comma-separated URLs or wildcard * for dev)
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# SQLite Database File Location (relative or absolute)
DATABASE_PATH=backend/database/appointments.db

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=15

# Notification Service Provider (Placeholder - keep disabled until provider is configured)
# NOTIFICATION_ENABLED=false
# NOTIFICATION_PROVIDER=smtp
# NOTIFICATION_API_KEY=
